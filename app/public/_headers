# Cloudflare Pages headers.
# The service worker file and manifest are not content-hashed, so they must
# always be revalidated — otherwise a stale sw.js/manifest can get stuck in
# a browser's HTTP cache and block the in-app update prompt from ever
# seeing a new version. Hashed build assets are the opposite case: their
# filenames change on every change, so it's safe to cache them forever.

/sw.js
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
